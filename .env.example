# =========================
# Supabase
# =========================
SUPABASE_URL=https://YOUR_PROJECT.supabase.co
SUPABASE_SECRET_KEY=YOUR_SUPABASE_SECRET_KEY
# Legacy fallback (optional)
SUPABASE_SERVICE_ROLE_KEY=
SUPABASE_PHOTO_BUCKET=wish-photos
PHOTO_MAX_BYTES=1500000
DEFAULT_WISH_EXPIRY=3d

# =========================
# Wish generation
# =========================
USE_GEMINI=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-2.5-flash

# =========================
# Website
# =========================
SITE_URL=https://thewishcrafts.vercel.app
PORT=3000

# =========================
# Telegram
# =========================
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
TELEGRAM_ADMIN_CHAT_IDS=
TELEGRAM_TIMEZONE=Asia/Kolkata

# Server starts the Telegram polling loop when true.
# IMPORTANT on Vercel: this MUST be false. Vercel functions are serverless
# (no long-running process), so polling cannot stay alive there — run
# `npm run bot` as a separate always-on service (Render/Railway/VPS) instead.
TELEGRAM_BOT_IN_SERVER=false

# =========================
# Private admin control plane
# =========================
# Set this in your Vercel Project → Settings → Environment Variables too,
# not just here. Without it, /admin login will always fail.
ADMIN_PANEL_KEY=replace-with-a-long-random-admin-key
# Optional: cleanup/report tuning
TEMP_ORPHAN_MAX_AGE_MS=3600000
METRICS_FLUSH_MS=60000

# =========================
# Vercel Cron (cleanup job)
# =========================
# vercel.json schedules a daily call to /api/cron/cleanup (setInterval-based
# cleanup does not run on serverless). Set this secret in Vercel's env vars;
# Vercel automatically sends it as "Authorization: Bearer <CRON_SECRET>".
CRON_SECRET=replace-with-another-long-random-secret

# Google AdSense is configured only in public/ad-config.js
